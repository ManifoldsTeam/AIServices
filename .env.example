# ===========================================
# Environment Template (.env.example)
# ===========================================
# Copy to .env and configure for your local setup.
# DO NOT commit .env to git!

# Environment selector: develop | product
ENV=develop

# Local development: path to service account key (optional)
# GOOGLE_APPLICATION_CREDENTIALS=key.json

# Override any setting from .env.{ENV} if needed:
# LOG_LEVEL=DEBUG
# LOG_FORMAT=console
